#-----------------------------------
# Add MetaGeneMark
WORKDIR /pipeline_tools
ADD https://github.com/billytaj/parkinson_int_meta_pipe/blob/develop/mgm/MetaGeneMark_linux_64.tar.gz?raw=true /pipeline_tools
RUN mkdir mgm \
&& mv MetaGeneMark_linux_64.tar.gz MetaGeneMark.tar \
&& tar -xvf MetaGeneMark.tar && mv MetaGeneMark_linux_64/mgm/* /pipeline_tools/mgm \
&& chmod 755 /pipeline_tools/mgm/gmhmmp




WORKDIR /pipeline_tools
RUN wget https://github.com/s-andrews/FastQC/archive/refs/tags/v0.12.1.zip -O fastqc.zip\
&& unzip fastqc.zip \
&& chmod 755 /pipeline_tools/FastQC-0.12.1/fastqc \ 
&& rm fastqc_v0.12.1.zip

#----------------------------------------
#Add kraken2
WORKDIR /pipeline_tools
RUN wget https://github.com/DerrickWood/kraken2/archive/refs/tags/v2.1.3.zip -O kraken2.zip \
&& unzip kraken2.zip \
&& cd kraken2-2.1.3 \
&& ./install_kraken2.sh . \
&& cd .. \
&& rm kraken2.zip \
&& mv kraken2-2.1.3 kraken2


#------------------------------------------------------------------------------------------
# Install Python3
ENV LANG=C.UTF-8 LC_ALL=C.UTF-8
RUN apt-get autoclean \
&& apt-get autoremove \
&& apt-get update \
&& apt-get clean && apt-get install -y python3 \
&& apt-get install -y python3-pip \
&& pip3 install biopython \
&& pip3 install pandas  \
&& pip3 install matplotlib \
&& pip3 install seaborn \
&& pip3 install pillow \
&& pip3 install psutil \
&& pip3 install hanging_threads \
&& pip3 install requests


RUN apt-get autoclean \
&& apt-get autoremove \
&& apt-get update \
&& apt-get clean && apt-get install -y valgrind && apt-get install -y heaptrack
