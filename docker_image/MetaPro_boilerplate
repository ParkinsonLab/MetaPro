FROM pytorch/pytorch:2.5.1-cuda12.4-cudnn9-devel
MAINTAINER Billy Taj

# Install system dependencies
RUN apt-get update && apt-get install -y \
    wget unzip build-essential gcc make cmake autoconf \
    libz-dev libbz2-dev libboost-all-dev flex libncurses5-dev \
    liblzma-dev perl vim less libcurl4-openssl-dev libgd-dev \
    default-jre default-jdk libidn11-dev valgrind heaptrack \
    bedtools nano git \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Install Python packages
RUN pip install --no-cache-dir \
    biopython pandas matplotlib seaborn pillow psutil requests \
    numpy scikit-learn tqdm transformers

WORKDIR /pipeline_tools

# Install all your bioinformatics tools (abbreviated for space)
RUN wget https://github.com/MikkelSchubert/adapterremoval/archive/refs/tags/v2.3.4.tar.gz -O adapterremoval.tar.gz \
    && mkdir adapterremoval && tar -xzf adapterremoval.tar.gz \
    && cd adapterremoval-2.3.4 && make && mv build/AdapterRemoval ../adapterremoval/ \
    && cd .. && rm -rf adapterremoval-2.3.4 adapterremoval.tar.gz

RUN wget https://github.com/BenLangmead/bowtie2/releases/download/v2.5.4/bowtie2-2.5.4-linux-x86_64.zip -O bowtie2.zip \
    && unzip bowtie2.zip && mv bowtie2-2.5.4-linux-x86_64 bowtie2 && rm bowtie2.zip

RUN wget https://github.com/bbuchfink/diamond/releases/download/v2.1.12/diamond-linux64.tar.gz \
    && mkdir DIAMOND && tar -xzf diamond-linux64.tar.gz -C DIAMOND && rm diamond-linux64.tar.gz

RUN wget http://eddylab.org/infernal/infernal-1.1.5.tar.gz \
    && tar -xzf infernal-1.1.5.tar.gz && mkdir infernal \
    && mv infernal-1.1.5/* infernal && rm -rf infernal-1.1.5 infernal-1.1.5.tar.gz \
    && cd infernal && ./configure && make && cd ..

RUN wget https://github.com/marbl/Krona/releases/download/v2.7/KronaTools-2.7.tar \
    && tar -xf KronaTools-2.7.tar && mkdir KronaTools \
    && mv KronaTools-2.7/* KronaTools/ && rm -rf KronaTools-2.7 KronaTools-2.7.tar \
    && cd KronaTools && perl install.pl && cd ..

RUN wget https://github.com/samtools/samtools/releases/download/1.21/samtools-1.21.tar.bz2 \
    && tar -xjf samtools-1.21.tar.bz2 && mkdir samtools \
    && cd samtools-1.21 && make && mv samtools ../samtools/ \
    && cd .. && rm -rf samtools-1.21 samtools-1.21.tar.bz2

RUN wget https://github.com/ablab/spades/releases/download/v4.2.0/SPAdes-4.2.0-Linux.tar.gz \
    && tar -xzf SPAdes-4.2.0-Linux.tar.gz && rm SPAdes-4.2.0-Linux.tar.gz

RUN wget https://github.com/torognes/vsearch/releases/download/v2.29.2/vsearch-2.29.2-linux-x86_64.tar.gz \
    && mkdir vsearch && tar -xzf vsearch-2.29.2-linux-x86_64.tar.gz \
    && mv vsearch-2.29.2-linux-x86_64 vsearch && rm vsearch-2.29.2-linux-x86_64.tar.gz

RUN wget https://ftp.ncbi.nlm.nih.gov/blast/executables/blast+/2.16.0/ncbi-blast-2.16.0+-x64-linux.tar.gz \
    && tar -xzf ncbi-blast-2.16.0+-x64-linux.tar.gz && mkdir BLAST_p \
    && mv ncbi-blast-2.16.0+/bin/* BLAST_p/ && rm -rf ncbi-blast-2.16.0+ ncbi-blast-2.16.0+-x64-linux.tar.gz

ADD https://github.com/billytaj/parkinson_int_meta_pipe/blob/develop/mgm/MetaGeneMark_linux_64.tar.gz?raw=true /pipeline_tools
RUN mkdir mgm && mv MetaGeneMark_linux_64.tar.gz MetaGeneMark.tar \
    && tar -xf MetaGeneMark.tar && mv MetaGeneMark_linux_64/mgm/* mgm/ \
    && chmod 755 mgm/gmhmmp && rm MetaGeneMark.tar

RUN wget https://github.com/s-andrews/FastQC/archive/refs/tags/v0.12.1.zip -O fastqc.zip \
    && unzip fastqc.zip && chmod 755 FastQC-0.12.1/fastqc && rm fastqc.zip

RUN wget https://github.com/DerrickWood/kraken2/archive/refs/tags/v2.14.zip -O kraken2.zip \
    && unzip kraken2.zip && cd kraken2-2.14 && ./install_kraken2.sh . \
    && cd .. && mv kraken2-2.14 kraken2 && rm kraken2.zip

RUN wget https://github.com/tseemann/barrnap/archive/refs/tags/0.9.zip -O barrnap.zip \
    && unzip barrnap.zip && rm barrnap.zip

RUN wget https://github.com/weizhongli/cdhit/releases/download/V4.8.1/cd-hit-v4.8.1-2019-0228.tar.gz \
    && tar -xzf cd-hit-v4.8.1-2019-0228.tar.gz && cd cd-hit-v4.8.1-2019-0228 \
    && make && cd cd-hit-auxtools && make && cd ../.. \
    && mkdir cdhit_dup && mv cd-hit-v4.8.1-2019-0228/* cdhit_dup/ \
    && rm -rf cd-hit-v4.8.1-2019-0228 cd-hit-v4.8.1-2019-0228.tar.gz

RUN wget https://compsysbio.org/metapro_hosting/mgm2.zip && unzip mgm2.zip && rm mgm2.zip

RUN wget https://github.com/kaistsystemsbiology/DeepProZyme/archive/refs/tags/v_1_0.zip -O DeepEC.zip \
    && unzip DeepEC.zip && rm DeepEC.zip

# Install DeepProZyme wrapper
RUN wget https://compsysbio.org/metapro_hosting/deepc_wrapper.py -O /usr/local/bin/run_deepectransformer.py \
    && chmod +x /usr/local/bin/run_deepectransformer.py

ENV PATH="${PATH}:/pipeline_tools/SPAdes-4.2.0-Linux/bin:/pipeline_tools/bowtie2:/pipeline_tools/DIAMOND"
ENV PATH="${PATH}:/pipeline_tools/infernal/src:/pipeline_tools/samtools:/pipeline_tools/vsearch/bin"
ENV PATH="${PATH}:/pipeline_tools/adapterremoval:/pipeline_tools/BLAST_p:/pipeline_tools/mgm"
ENV PATH="${PATH}:/pipeline_tools/FastQC-0.12.1:/pipeline_tools/kraken2:/pipeline_tools/barrnap-0.9/bin"
ENV PATH="${PATH}:/pipeline_tools/cdhit_dup/cd-hit-auxtools:/pipeline_tools/mgm2/src"
ENV PATH="${PATH}:/pipeline_tools/DeepProZyme-v_1_0"