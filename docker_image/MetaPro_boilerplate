# MetaPro Tools Stash Dockerfile - v5.2 (CLEAN Pinned Version)

#=============================================================================
# STAGE 1: CLEAN Builder on Ubuntu 20.04
# This stage creates a self-contained Python 3.8 environment for CLEAN.
#=============================================================================
FROM ubuntu:20.04 AS clean-builder

# Install Python 3.8 and venv
RUN apt-get update && apt-get install -y python3.8 python3.8-venv wget unzip && rm -rf /var/lib/apt/lists/*

# Create the virtual environment
RUN python3.8 -m venv /opt/venv_clean

# Install CLEAN and its old dependencies into the venv.
# Download a specific, stable commit of CLEAN that contains the download.sh script.
RUN /opt/venv_clean/bin/pip install --no-cache-dir --upgrade pip \
 && /opt/venv_clean/bin/pip install --no-cache-dir loguru matplotlib==3.7.0 numpy==1.22.3 pandas==1.4.2 scikit_learn==1.2.0 scipy==1.7.3 tqdm==4.64.0 fair_esm==2.0.0 setuptools \
 && wget https://github.com/tttianhao/CLEAN/archive/refs/tags/v1.0.1.zip -O CLEAN.zip \
 && unzip CLEAN.zip \
 && mv CLEAN-1.0.1 /opt/CLEAN \
 && rm CLEAN.zip

WORKDIR /opt/CLEAN
RUN /opt/venv_clean/bin/python build.py install

#=============================================================================
# STAGE 2: Final Image on Ubuntu 24.04
# This is the final, modern image that will contain all the tools.
#=============================================================================
FROM ubuntu:24.04

LABEL maintainer="Billy Taj"
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies, including prerequisites for adding Python 3.8
RUN apt-get update && apt-get install -y \
    build-essential g++ gcc make cmake autoconf \
    python3 python3-pip python3-venv \
    wget unzip perl default-jre default-jdk nano less git bedtools valgrind heaptrack \
    libz-dev libbz2-dev libboost-all-dev flex libncurses5-dev liblzma-dev libcurl4-openssl-dev libgd-dev libidn11-dev \
    software-properties-common \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update \
    && apt-get install -y python3.8 python3.8-venv \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Install common Python packages globally using the modern Python 3.12
RUN pip install --no-cache-dir --break-system-packages \
    biopython \
    pandas \
    matplotlib \
    seaborn \
    pillow \
    psutil \
    requests \
    hanging_threads \
    setuptools

WORKDIR /pipeline_tools

# Install all other bioinformatics tools (non-CLEAN)
RUN wget https://github.com/MikkelSchubert/adapterremoval/archive/refs/tags/v2.3.4.tar.gz -O ar.tar.gz \
 && mkdir /pipeline_tools/adapterremoval && tar -xzvf ar.tar.gz && cd adapterremoval-2.3.4 && make \
 && mv build/AdapterRemoval /pipeline_tools/adapterremoval/ && cd /pipeline_tools && rm -rf ar.tar.gz adapterremoval-2.3.4
RUN wget https://github.com/BenLangmead/bowtie2/releases/download/v2.5.3/bowtie2-2.5.3-linux-x86_64.zip -O bowtie2.zip \
 && unzip bowtie2.zip && mv bowtie2-2.5.3-linux-x86_64 bowtie2 && rm bowtie2.zip
RUN wget https://github.com/bbuchfink/diamond/releases/download/v2.1.9/diamond-linux64.tar.gz -O DIAMOND.tar.gz \
 && mkdir DIAMOND && tar -xzvf DIAMOND.tar.gz -C DIAMOND && rm DIAMOND.tar.gz
RUN wget http://eddylab.org/infernal/infernal-1.1.5.tar.gz -O infernal.tar.gz \
 && tar -xzvf infernal.tar.gz && cd infernal-1.1.5 && ./configure --prefix=/pipeline_tools/infernal && make && make install \
 && cd /pipeline_tools && rm -rf infernal.tar.gz infernal-1.1.5
RUN wget https://github.com/marbl/Krona/releases/download/v2.8.1/KronaTools-2.8.1.tar -O KronaTools.tar \
 && tar -xvf KronaTools.tar && cd KronaTools-2.8.1 && perl install.pl --prefix=/pipeline_tools/KronaTools \
 && cd /pipeline_tools && rm -rf KronaTools.tar KronaTools-2.8.1
RUN wget https://github.com/samtools/samtools/releases/download/1.21/samtools-1.21.tar.bz2 -O samtools.tar.bz2 \
 && tar -xjvf samtools.tar.bz2 && cd samtools-1.21 && ./configure --prefix=/pipeline_tools/samtools && make && make install \
 && cd /pipeline_tools && rm -rf samtools.tar.bz2 samtools-1.21
RUN wget https://github.com/ablab/spades/releases/download/v3.15.5/SPAdes-3.15.5-Linux.tar.gz -O SPAdes.tar.gz \
 && tar -xzvf SPAdes.tar.gz && mv SPAdes-3.15.5-Linux SPAdes && rm SPAdes.tar.gz
RUN wget https://github.com/torognes/vsearch/releases/download/v2.29.2/vsearch-2.29.2-linux-x86_64.tar.gz -O vsearch.tar.gz \
 && tar -xzvf vsearch.tar.gz && mv vsearch-2.29.2-linux-x86_64 vsearch && rm vsearch.tar.gz
RUN wget https://ftp.ncbi.nlm.nih.gov/blast/executables/blast+/2.16.0/ncbi-blast-2.16.0+-x64-linux.tar.gz -O BLAST_p.tar.gz \
 && tar -xzvf BLAST_p.tar.gz && mv ncbi-blast-2.16.0+ BLAST_p && rm BLAST_p.tar.gz
ADD https://raw.githubusercontent.com/billytaj/parkinson_int_meta_pipe/develop/mgm/MetaGeneMark_linux_64.tar.gz /pipeline_tools/MetaGeneMark.tar.gz
RUN mkdir mgm && tar -xzvf MetaGeneMark.tar.gz -C mgm --strip-components=2 && chmod 755 /pipeline_tools/mgm/gmhmmp && rm MetaGeneMark.tar.gz
RUN wget https://github.com/s-andrews/FastQC/archive/refs/tags/v0.12.1.zip -O fastqc.zip \
 && unzip fastqc.zip && chmod 755 /pipeline_tools/FastQC-0.12.1/fastqc && rm fastqc.zip
RUN wget https://github.com/DerrickWood/kraken2/archive/refs/tags/v2.1.6.zip -O kraken2.zip \
 && unzip kraken2.zip && cd kraken2-2.1.6 && ./install_kraken2.sh /pipeline_tools/kraken2 \
 && cd /pipeline_tools && rm -rf kraken2.zip kraken2-2.1.6
RUN wget https://github.com/tseemann/barrnap/archive/refs/tags/0.9.zip -O barrnap.zip \
 && unzip barrnap.zip && rm barrnap.zip
RUN wget https://github.com/weizhongli/cdhit/releases/download/V4.8.1/cd-hit-v4.8.1-2019-0228.tar.gz -O cdhit.tar.gz \
 && tar -xzvf cdhit.tar.gz && mkdir /pipeline_tools/cd-hit && cd cd-hit-v4.8.1-2019-0228 && make \
 && mv * /pipeline_tools/cd-hit && cd /pipeline_tools && rm -rf cdhit.tar.gz cd-hit-v4.8.1-2019-0228
RUN wget https://compsysbio.org/metapro_hosting/mgm2.zip \
 && unzip mgm2.zip && rm mgm2.zip

# Create a new venv and install CLEAN and its dependencies
RUN python3.8 -m venv /pipeline_tools/venv_clean
RUN /pipeline_tools/venv_clean/bin/pip install --no-cache-dir --upgrade pip \
 && /pipeline_tools/venv_clean/bin/pip install --no-cache-dir loguru matplotlib==3.7.0 numpy==1.22.3 pandas==1.4.2 scikit_learn==1.2.0 scipy==1.7.3 tqdm==4.64.0 fair_esm==2.0.0 setuptools torch
COPY --from=clean-builder /opt/CLEAN /pipeline_tools/CLEAN

# Install CLEAN properly in the new location
WORKDIR /pipeline_tools/CLEAN
RUN /pipeline_tools/venv_clean/bin/python build.py install

# Set the environment variables for all tools
ENV PATH="\
    /pipeline_tools/venv_clean/bin:\
    /pipeline_tools/adapterremoval:\
    /pipeline_tools/bowtie2:\
    /pipeline_tools/DIAMOND:\
    /pipeline_tools/infernal/bin:\
    /pipeline_tools/KronaTools/bin:\
    /pipeline_tools/samtools/bin:\
    /pipeline_tools/SPAdes/bin:\
    /pipeline_tools/vsearch/bin:\
    /pipeline_tools/BLAST_p/bin:\
    /pipeline_tools/kraken2/bin:\
    /pipeline_tools/cd-hit:\
    /pipeline_tools/mgm:\
    /pipeline_tools/FastQC-0.12.1:\
    /pipeline_tools/barrnap-0.9/bin:\
    /pipeline_tools/mgm2/src:\
    /pipeline_tools/CLEAN:\
    ${PATH}"